# Elara Relay environment template — placeholders only.
NODE_ENV=development

# Privileged Node API plane
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elara?sslmode=disable
ELARA_DB_POOL_MAX=5
ELARA_DB_IDLE_TIMEOUT_MS=30000
ELARA_DB_CONNECTION_TIMEOUT_MS=10000
ELARA_DB_STATEMENT_TIMEOUT_MS=10000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ELARA_ALLOWED_USER_IDS=00000000-0000-4000-8000-000000000000
ELARA_AUTH_REQUEST_TIMEOUT_MS=5000
ELARA_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Required explicitly in production
# ELARA_HOST=0.0.0.0
# PORT=8787
# ELARA_SHUTDOWN_TIMEOUT_MS=10000
# ELARA_READINESS_TIMEOUT_MS=2000
# ELARA_HTTP_REQUEST_TIMEOUT_MS=30000
# ELARA_HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# Safe public build metadata
# ELARA_BUILD_SHA=0123456789abcdef

# Optional memory provider
# ELARA_MEMORY_PROVIDER=none
# ELARA_HINDSIGHT_URL=http://localhost:8888
# ELARA_HINDSIGHT_API_KEY=replace_me
# ELARA_MEMORY_REQUEST_TIMEOUT_MS=5000

# Optional Chat providers — server-only keys
# ELARA_OPENAI_API_KEY=replace_me
# ELARA_OPENAI_BASE_URL=https://api.openai.com/v1
# ELARA_MUSE_API_KEY=replace_me
# ELARA_MUSE_BASE_URL=https://api.meta.ai/v1
# ELARA_CHAT_REQUEST_TIMEOUT_MS=120000

# Public browser plane
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ELARA_API_URL=http://127.0.0.1:8787
