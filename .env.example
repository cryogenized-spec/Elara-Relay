# Elara Relay — environment template (local placeholders only).
#
# Two deployment planes are configured here. Never merge them:
#
#   1. the privileged Node API plane (server-only, secret store)
#   2. the static browser plane (public, build-time values)
#
# See docs/production-deployment.md for the full contract.

# ===========================================================================
# Privileged Node API plane — server-only
# ===========================================================================

# Deployment profile: production | development | test.
# An absent value is treated as production (fail closed); an unrecognized
# value is a startup failure.
NODE_ENV=development

# --- PostgreSQL (secret) ---------------------------------------------------
# Remote hosts must use TLS: a missing sslmode is normalized to
# sslmode=require and sslmode=disable is rejected outside loopback.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elara?sslmode=disable
ELARA_DB_POOL_MAX=5
ELARA_DB_IDLE_TIMEOUT_MS=30000
ELARA_DB_CONNECTION_TIMEOUT_MS=10000
ELARA_DB_STATEMENT_TIMEOUT_MS=10000

# --- Supabase Auth verification (server-side) ------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Owner allowlist: at least one Supabase Auth user UUID, no duplicates.
ELARA_ALLOWED_USER_IDS=00000000-0000-4000-8000-000000000000
ELARA_AUTH_REQUEST_TIMEOUT_MS=5000

# --- Trusted browser origins (CORS) ---------------------------------------
# Exact origins only: no wildcards, no paths, no credentials, no duplicates.
# Production requires HTTPS for every origin.
ELARA_ALLOWED_ORIGINS=http://127.0.0.1:4173

# --- HTTP transport and lifecycle -----------------------------------------
# Both are REQUIRED in production; the defaults below apply to development
# and test profiles only.
# ELARA_HOST=127.0.0.1
# PORT=8787
# ELARA_SHUTDOWN_TIMEOUT_MS=10000
# ELARA_READINESS_TIMEOUT_MS=2000
# ELARA_HTTP_REQUEST_TIMEOUT_MS=30000
# ELARA_HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# --- Optional memory provider ---------------------------------------------
# "none" (default, no AI memory) or "hindsight"
# ELARA_MEMORY_PROVIDER=none
# ELARA_HINDSIGHT_URL=http://localhost:8888
# Required for non-loopback Hindsight; omit only for unauthenticated loopback.
# ELARA_HINDSIGHT_API_KEY=replace_me
# ELARA_MEMORY_REQUEST_TIMEOUT_MS=5000

# ===========================================================================
# Browser plane — public values inlined at build time (GitHub Pages)
# ===========================================================================
# These are shipped to every visitor. Only publishable material belongs here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ELARA_API_URL=http://127.0.0.1:8787
