DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elara?sslmode=disable
ELARA_DB_POOL_MAX=5
ELARA_DB_IDLE_TIMEOUT_MS=30000
ELARA_DB_CONNECTION_TIMEOUT_MS=10000
ELARA_DB_STATEMENT_TIMEOUT_MS=10000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ELARA_ALLOWED_USER_IDS=00000000-0000-4000-8000-000000000000
ELARA_AUTH_REQUEST_TIMEOUT_MS=5000
ELARA_ALLOWED_ORIGINS=http://127.0.0.1:4173
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ELARA_API_URL=http://127.0.0.1:8787

# --- Recovery (server-only; never exposed to the browser) ---
# Restore target: a SEPARATE database on the same PostgreSQL server.
# Recovery replaces it during verified restores.
ELARA_RECOVERY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elara_recovery?sslmode=disable
# Optional explicit pg_dump/pg_restore paths; must match the server major
# version. Defaults to PATH lookup.
# ELARA_RECOVERY_PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
# ELARA_RECOVERY_PG_RESTORE=/usr/lib/postgresql/17/bin/pg_restore
# Server-side path of the restore-verification report served at
# GET /recovery/status.
# ELARA_RECOVERY_REPORT_PATH=/var/lib/elara/recovery/restore-verification.json
