{
  "name": "elara-relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:ts6 && vite build",
    "build:server": "vite build --config vite.server.config.mjs",
    "start": "node dist-server/server.mjs",
    "start:local": "node --env-file-if-exists=.env dist-server/server.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck:ts6": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.e2e.json --noEmit && tsc6 -p tsconfig.integration.json --noEmit",
    "typecheck:ts7": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tsconfig.e2e.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tsconfig.integration.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify:gates": "node scripts/check-verification-integrity.mjs",
    "secrets:check": "node scripts/secret-scan.mjs",
    "adversarial:check": "node scripts/adversarial-foundation-gate.mjs",
    "verify": "npm run verify:gates && npm run secrets:check && npm run security:check && npm run auth:check && npm run docs:check && npm run supply-chain:check && npm run test:quality && npm run lint && npm run typecheck:ts6 && npm run typecheck:ts7 && npm run test:coverage && npm run adversarial:check && npm run adversarial:domain && npm run adversarial:auth && npm run schema:check && npm run build && npm run build:server && npm run production:check",
    "supply-chain:check": "node scripts/supply-chain-gate.mjs",
    "test:quality": "node scripts/test-quality-gate.mjs",
    "security:check": "node scripts/security-architecture-gate.mjs",
    "adversarial:domain": "node scripts/adversarial-domain-gate.mjs",
    "schema:check": "node scripts/migration-contract-gate.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.mjs",
    "auth:check": "node scripts/auth-boundary-gate.mjs",
    "adversarial:auth": "node scripts/adversarial-auth-gate.mjs",
    "docs:check": "node scripts/documentation-contract-gate.mjs",
    "production:check": "node scripts/production-deployment-gate.mjs"
  },
  "dependencies": {
    "@iconify-icons/solar": "2.0.4",
    "@iconify/react": "6.0.3",
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1"
  }
}
